rules_version = '2';

// =============================================================================
// Code Baiz — SINGLE source of truth for Firestore
// Used by: public website (react-js-code-baiz-landing) + admin panel
// Deploy ONCE from react-js-code-baiz-admin:  firebase deploy --only firestore:rules
// Do NOT maintain a second copy in the landing repo.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Blogs: website reads publicly; only signed-in admins create/update/delete
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Jobs: website lists open roles; only admins manage
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Applicants: website form can create; only admins read/update/delete
    match /applicants/{applicantId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
